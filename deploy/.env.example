# Copy to deploy/.env and fill in. Never commit the real file.

# Image tag to run: a release version such as 1.0.0 (required; there is no
# default so a stack never silently tracks a moving tag).
DOORWARDEN_TAG=

# Host ports. Use 8080/8443 for the pre-cutover trial while NPM keeps 80/443.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Used to encrypt secrets at rest in /data (REQUIRED, deliberately empty: the
# stack refuses to start until you set one). Generate with:
#   openssl rand -base64 32
DOORWARDEN_MASTER_KEY=

# TrueNAS API key (if the TrueNAS source is enabled in the config file).
TRUENAS_API_KEY=

# DNS provider credentials referenced from the config file as ${NAME}.
DNS_API_TOKEN=
# Group id owning /var/run/docker.sock on the host (the socket proxy needs it).
# Find it with: stat -c %g /var/run/docker.sock
DOCKER_GID=999
