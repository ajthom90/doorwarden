# Copy to deploy/.env and fill in. Never commit the real file.

# Image tag to run (see the project's releases).
DOORWARDEN_TAG=latest

# Host ports. Use 8080/8443 for the pre-cutover trial while NPM keeps 80/443.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Used to encrypt secrets at rest in /data. Generate with: openssl rand -base64 32
DOORWARDEN_MASTER_KEY=change-me

# TrueNAS API key (if the TrueNAS source is enabled in the config file).
TRUENAS_API_KEY=change-me

# DNS provider credentials referenced from the config file as ${NAME}.
DNS_API_TOKEN=change-me
